# Base (insforge)
NEXT_PUBLIC_INSFORGE_URL=https://your-app.region.insforge.app
NEXT_PUBLIC_INSFORGE_ANON_KEY=your-public-anon-key
INSFORGE_SERVICE_ROLE_KEY=your-service-role-key

# Session/auth
SESSION_SECRET=replace-with-a-random-long-secret
ADMIN_PIN=replace-with-secure-admin-pin
CRON_SECRET=replace-with-cron-bearer-secret

# OTP
OTP_PROVIDER=email
OTP_EMAIL_FROM=no-reply@your-domain.com
OTP_DEV_ECHO_CODE=false

# WhatsApp support
SUPPORT_WHATSAPP_NUMBER=59899123456
NEXT_PUBLIC_SUPPORT_WHATSAPP_NUMBER=59899123456

# Receipt branding
NEXT_PUBLIC_RECEIPT_ISSUER_NAME=Fede Motos Servicios
NEXT_PUBLIC_RECEIPT_ISSUER_PHONE=59899123456
NEXT_PUBLIC_RECEIPT_ISSUER_ADDRESS=Montevideo, Uruguay

# Staging test runner only
E2E_STAGING_BASE_URL=https://your-preview.vercel.app
E2E_STAGING_ADMIN_PIN=replace-with-staging-admin-pin
E2E_STAGING_SERVICE_ROLE_KEY=replace-with-staging-service-role-key
