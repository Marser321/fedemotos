{
    "name": "Recordatorios Automaticos (Daily Cron)",
    "nodes": [
        {
            "parameters": {
                "rule": {
                    "interval": [
                        {
                            "field": "hours",
                            "hoursInterval": 24
                        }
                    ]
                }
            },
            "name": "Cron Diario 9AM",
            "type": "n8n-nodes-base.scheduleTrigger",
            "typeVersion": 1.2,
            "position": [
                200,
                300
            ]
        },
        {
            "parameters": {
                "operation": "read",
                "fileSelector": "/data/clientes.csv",
                "options": {}
            },
            "name": "Leer Clientes",
            "type": "n8n-nodes-base.spreadsheetFile",
            "typeVersion": 4.5,
            "position": [
                400,
                300
            ]
        },
        {
            "parameters": {
                "conditions": {
                    "options": {
                        "caseSensitive": true
                    },
                    "combinator": "and",
                    "conditions": [
                        {
                            "leftValue": "={{ Math.ceil((new Date($json.Fecha_Vencimiento) - new Date()) / (1000*60*60*24)) }}",
                            "rightValue": 3,
                            "operator": {
                                "type": "number",
                                "operation": "lte"
                            }
                        },
                        {
                            "leftValue": "={{ Math.ceil((new Date($json.Fecha_Vencimiento) - new Date()) / (1000*60*60*24)) }}",
                            "rightValue": 0,
                            "operator": {
                                "type": "number",
                                "operation": "gte"
                            }
                        }
                    ]
                }
            },
            "name": "Filtrar Por Vencer (3 dias)",
            "type": "n8n-nodes-base.filter",
            "typeVersion": 2,
            "position": [
                600,
                300
            ]
        },
        {
            "parameters": {
                "assignments": {
                    "assignments": [
                        {
                            "id": "mensaje",
                            "name": "mensaje",
                            "value": "=Hola {{ $json.Nombre_Completo }}! 👋 Te recordamos que tu plan de Auxilio Mecánico vence en {{ Math.ceil((new Date($json.Fecha_Vencimiento) - new Date()) / (1000*60*60*24)) }} días. Renova ahora y seguí protegido! 🛡️ Contactanos para ofertas exclusivas.",
                            "type": "string"
                        },
                        {
                            "id": "telefono",
                            "name": "telefono",
                            "value": "={{ $json.Telefono }}",
                            "type": "string"
                        }
                    ]
                },
                "options": {}
            },
            "name": "Preparar Mensaje WhatsApp",
            "type": "n8n-nodes-base.set",
            "typeVersion": 3.4,
            "position": [
                800,
                300
            ]
        },
        {
            "parameters": {
                "method": "POST",
                "url": "={{ $env.WHATSAPP_API_URL || 'http://whatsapp:3000/api/sendText' }}",
                "sendHeaders": true,
                "headerParameters": {
                    "parameters": [
                        {
                            "name": "Content-Type",
                            "value": "application/json"
                        }
                    ]
                },
                "sendBody": true,
                "specifyBody": "json",
                "jsonBody": "={\n  \"chatId\": \"{{ $json.telefono.replace(/\\\\D/g, '') }}@c.us\",\n  \"text\": \"{{ $json.mensaje }}\",\n  \"session\": \"{{ $env.WHATSAPP_SESSION || 'default' }}\"\n}",
                "options": {
                    "timeout": 10000
                }
            },
            "name": "Enviar WhatsApp via WAHA",
            "type": "n8n-nodes-base.httpRequest",
            "typeVersion": 4.2,
            "position": [
                1000,
                300
            ]
        },
        {
            "parameters": {
                "operation": "append",
                "documentId": {
                    "__rl": true,
                    "value": "/data/logs_whatsapp.csv",
                    "mode": "url"
                },
                "sheetName": {
                    "__rl": true,
                    "value": "gid=0",
                    "mode": "list"
                },
                "columns": {
                    "mappingMode": "autoMapInputData"
                },
                "options": {}
            },
            "name": "Log Envio",
            "type": "n8n-nodes-base.spreadsheetFile",
            "typeVersion": 4.5,
            "position": [
                1200,
                300
            ]
        }
    ],
    "connections": {
        "Cron Diario 9AM": {
            "main": [
                [
                    {
                        "node": "Leer Clientes",
                        "type": "main",
                        "index": 0
                    }
                ]
            ]
        },
        "Leer Clientes": {
            "main": [
                [
                    {
                        "node": "Filtrar Por Vencer (3 dias)",
                        "type": "main",
                        "index": 0
                    }
                ]
            ]
        },
        "Filtrar Por Vencer (3 dias)": {
            "main": [
                [
                    {
                        "node": "Preparar Mensaje WhatsApp",
                        "type": "main",
                        "index": 0
                    }
                ]
            ]
        },
        "Preparar Mensaje WhatsApp": {
            "main": [
                [
                    {
                        "node": "Enviar WhatsApp via WAHA",
                        "type": "main",
                        "index": 0
                    }
                ]
            ]
        },
        "Enviar WhatsApp via WAHA": {
            "main": [
                [
                    {
                        "node": "Log Envio",
                        "type": "main",
                        "index": 0
                    }
                ]
            ]
        }
    }
}