{
    "name": "API Clientes UNIFICADO (GET + POST)",
    "nodes": [
        {
            "parameters": {
                "path": "api/clientes",
                "httpMethod": "={{ $request.method }}",
                "responseMode": "lastNode",
                "options": {
                    "rawBody": true
                }
            },
            "name": "Webhook API Clientes",
            "type": "n8n-nodes-base.webhook",
            "typeVersion": 2,
            "position": [
                200,
                300
            ],
            "webhookId": "clientes-api"
        },
        {
            "parameters": {
                "conditions": {
                    "options": {
                        "caseSensitive": true
                    },
                    "combinator": "and",
                    "conditions": [
                        {
                            "leftValue": "={{ $json.headers['content-type'] }}",
                            "rightValue": "application/json",
                            "operator": {
                                "type": "string",
                                "operation": "contains"
                            }
                        }
                    ]
                }
            },
            "name": "Es POST?",
            "type": "n8n-nodes-base.if",
            "typeVersion": 2,
            "position": [
                400,
                300
            ]
        },
        {
            "parameters": {
                "operation": "read",
                "fileSelector": "/data/clientes.csv",
                "options": {}
            },
            "name": "Leer CSV (GET)",
            "type": "n8n-nodes-base.spreadsheetFile",
            "typeVersion": 4.5,
            "position": [
                600,
                400
            ]
        },
        {
            "parameters": {
                "assignments": {
                    "assignments": [
                        {
                            "id": "id",
                            "name": "Cliente_ID",
                            "value": "={{ 'CLI_' + Date.now() }}",
                            "type": "string"
                        },
                        {
                            "id": "nombre",
                            "name": "Nombre_Completo",
                            "value": "={{ $json.body.nombre }}",
                            "type": "string"
                        },
                        {
                            "id": "telefono",
                            "name": "Telefono",
                            "value": "={{ $json.body.telefono }}",
                            "type": "string"
                        },
                        {
                            "id": "matricula",
                            "name": "Matricula",
                            "value": "={{ $json.body.matricula }}",
                            "type": "string"
                        },
                        {
                            "id": "modelo",
                            "name": "Modelo",
                            "value": "={{ $json.body.modelo }}",
                            "type": "string"
                        },
                        {
                            "id": "fecha_inicio",
                            "name": "Fecha_Inicio",
                            "value": "={{ $json.body.fecha_inicio }}",
                            "type": "string"
                        },
                        {
                            "id": "fecha_vencimiento",
                            "name": "Fecha_Vencimiento",
                            "value": "={{ $json.body.fecha_vencimiento }}",
                            "type": "string"
                        }
                    ]
                },
                "options": {}
            },
            "name": "Preparar Datos (POST)",
            "type": "n8n-nodes-base.set",
            "typeVersion": 3.4,
            "position": [
                600,
                200
            ]
        },
        {
            "parameters": {
                "operation": "append",
                "documentId": {
                    "__rl": true,
                    "value": "/data/clientes.csv",
                    "mode": "url"
                },
                "sheetName": {
                    "__rl": true,
                    "value": "gid=0",
                    "mode": "list"
                },
                "columns": {
                    "mappingMode": "autoMapInputData"
                },
                "options": {}
            },
            "name": "Escribir en CSV (POST)",
            "type": "n8n-nodes-base.spreadsheetFile",
            "typeVersion": 4.5,
            "position": [
                800,
                200
            ]
        },
        {
            "parameters": {
                "respondWith": "json",
                "responseBody": "={{ { success: true, message: 'Cliente guardado' } }}"
            },
            "name": "Respuesta Exito (POST)",
            "type": "n8n-nodes-base.respondToWebhook",
            "typeVersion": 1.1,
            "position": [
                1000,
                200
            ]
        },
        {
            "parameters": {
                "respondWith": "allIncomingItems",
                "options": {}
            },
            "name": "Respuesta JSON (GET)",
            "type": "n8n-nodes-base.respondToWebhook",
            "typeVersion": 1.1,
            "position": [
                800,
                400
            ]
        }
    ],
    "connections": {
        "Webhook API Clientes": {
            "main": [
                [
                    {
                        "node": "Es POST?",
                        "type": "main",
                        "index": 0
                    }
                ]
            ]
        },
        "Es POST?": {
            "main": [
                [
                    {
                        "node": "Preparar Datos (POST)",
                        "type": "main",
                        "index": 0
                    }
                ],
                [
                    {
                        "node": "Leer CSV (GET)",
                        "type": "main",
                        "index": 0
                    }
                ]
            ]
        },
        "Preparar Datos (POST)": {
            "main": [
                [
                    {
                        "node": "Escribir en CSV (POST)",
                        "type": "main",
                        "index": 0
                    }
                ]
            ]
        },
        "Escribir en CSV (POST)": {
            "main": [
                [
                    {
                        "node": "Respuesta Exito (POST)",
                        "type": "main",
                        "index": 0
                    }
                ]
            ]
        },
        "Leer CSV (GET)": {
            "main": [
                [
                    {
                        "node": "Respuesta JSON (GET)",
                        "type": "main",
                        "index": 0
                    }
                ]
            ]
        }
    }
}